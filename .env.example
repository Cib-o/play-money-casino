# ── Play-money casino configuration ──────────────────────────────────
# Copy this file to .env and fill in SESSION_SECRET before starting:
#   cp .env.example .env

# Port the HTTP server listens on.
PORT=3000

# Interface to bind to. Keep 127.0.0.1 when running behind an nginx
# reverse proxy; set 0.0.0.0 only if you expose Node directly.
HOST=127.0.0.1

# REQUIRED. Secret used to sign session cookies (HMAC-SHA256).
# At least 32 characters — the server refuses to start otherwise.
# Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Set to "production" on a server so session cookies are only sent
# over HTTPS (Secure flag).
NODE_ENV=development

# Directory that holds the SQLite database. Created automatically.
DATA_DIR=./data
